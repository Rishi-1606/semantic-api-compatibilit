# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
POSTGRES_DB=semantic_api_db
POSTGRES_USER=semantic_user
POSTGRES_PASSWORD=changeme_strong_password

# Spring Boot datasource
DATABASE_URL=jdbc:postgresql://localhost:5432/semantic_api_db
DATABASE_USERNAME=semantic_user
DATABASE_PASSWORD=changeme_strong_password

# ──────────────────────────────────────────────
# AI / NLP Service
# ──────────────────────────────────────────────
# Used by the backend to call an external embedding/LLM service.
# Replace with your actual API key. Never commit the real key.
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=https://api.openai.com/v1

# ──────────────────────────────────────────────
# Node.js Gateway
# ──────────────────────────────────────────────
GATEWAY_PORT=3001
BACKEND_URL=http://localhost:8080
NODE_ENV=development

# ──────────────────────────────────────────────
# React Frontend
# ──────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8080
VITE_GATEWAY_URL=http://localhost:3001
