# Gateway environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to Git.

PORT=3001
BACKEND_URL=http://localhost:8080
NODE_ENV=development

# Phase 10: Target mock API base URLs
# Used when ApiVersion.baseUrl is not set in the backend registry.
MOCK_API_V1_URL=http://localhost:8081
MOCK_API_V2_URL=http://localhost:8082

# Phase 10: In-process rule cache TTL in milliseconds (default 60 000 = 60 seconds).
# After a rule approval/rejection in the backend, the gateway picks up the change
# within this window. Lower values reduce latency; higher values reduce backend load.
RULE_CACHE_TTL_MS=60000

# Phase 10: Timeout for forwarded requests to the target API in milliseconds.
TARGET_TIMEOUT_MS=10000
